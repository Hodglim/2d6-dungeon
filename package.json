{
  "name": "2d6-map-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "creature-pack": "node scripts/make-creature-pack.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "e2e:pwa": "node scripts/e2e-pwa.mjs",
    "e2e:persistence": "node scripts/e2e-persistence.mjs",
    "deploy": "npm run build && node scripts/check-dist.mjs && wrangler pages deploy dist --project-name 2d6-map-maker"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
